# TrackIt frontend configuration example
#
# Important: every REACT_APP_* value is embedded into the browser bundle by
# Create React App. Never place passwords, private API keys or server-side
# credentials here.

REACT_APP_USE_BACKEND=false
REACT_APP_SECRET_KEY_CAPTCHA=public-client-key-placeholder
REACT_APP_CLIENT_URI=http://localhost:3000
