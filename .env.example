# TrackIt frontend browser-public configuration
#
# Vite exposes VITE_* values to browser-delivered JavaScript.
# Never place passwords, private API keys, CAPTCHA server secrets, or other
# privileged credentials in this file.
#
# The historical external backend is configurable from one authority. The
# maintained default is HTTPS to avoid mixed-content from the Vercel frontend.
VITE_API_BASE_URL=https://trackit.somee.com

# Optional. Leave empty to derive callback URLs from window.location.origin.
# Set only when email callbacks must use a different public frontend origin.
VITE_APP_BASE_URL=
